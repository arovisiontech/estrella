# Supabase Configuration
# Get these values from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Site URL for production metadata and OAuth redirects
# Set this to your Vercel production URL or custom domain
NEXT_PUBLIC_SITE_URL=https://torque-motorcycle.vercel.app

# The service role key is only needed for local migration/sync scripts
# It should NOT be deployed to Vercel or exposed in the browser
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here (local scripts only)
